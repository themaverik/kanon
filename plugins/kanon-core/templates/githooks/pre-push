#!/usr/bin/env bash
# pre-push: block pushes whose outgoing commits add secrets or sensitive content.
# Lives at the git layer, so it fires for every client - Claude Code, Codex,
# Cursor, Antigravity, plain CLI - unlike editor-specific hooks.
#
# Scans only the ADDED lines of the commits being pushed (never the whole tree,
# never commit messages or author lines). Findings are reported masked: file,
# line, pattern name, first characters only - the secret itself is not echoed.
#
# Extra org terms (codenames, handles): export BANNED='term1|term2' - same
# convention as scripts/leak-check.sh; set it as a masked CI/shell variable so
# the list itself never lands in the tree.
# Bypass once, deliberately: SKIP_SECRET_HOOK=1 git push ...
# CI stays the backstop: this hook is best-effort and fails open when python3
# or git plumbing is unavailable.
[ "${SKIP_SECRET_HOOK:-0}" = "1" ] && exit 0
command -v python3 >/dev/null 2>&1 || exit 0

refs="$(cat)"
[ -z "$refs" ] && exit 0

# Program is single-quoted (shell-quote bug class); \x22 and \x27 stand in for quotes in regexes.
python3 -c '
import os, re, subprocess, sys

refs = sys.argv[1].strip().splitlines()
PATTERNS = [
    ("aws-access-key-id",  r"\b(AKIA|ASIA|ABIA|ACCA)[0-9A-Z]{16}\b"),
    ("private-key-block",  r"-----BEGIN [A-Z ]*PRIVATE KEY"),
    ("github-token",       r"\bgh[pousr]_[A-Za-z0-9]{36,}"),
    ("gitlab-pat",         r"\bglpat-[A-Za-z0-9_-]{20,}"),
    ("slack-token",        r"\bxox[baprs]-[A-Za-z0-9-]{10,}"),
    ("google-api-key",     r"\bAIza[0-9A-Za-z_-]{35}"),
    ("stripe-live-key",    r"\bsk_live_[A-Za-z0-9]{20,}"),
    ("generic-secret-assignment",
     r"(?i)\b(password|passwd|secret|api[_-]?key|access[_-]?token|auth[_-]?token)\b\s*[:=]\s*[\x22\x27][^\x22\x27]{8,}"),
]
ALLOW = re.compile(r"(?i)example|placeholder|changeme|dummy|your[-_]|\$\{|\{\{|<[^>]*>|redacted|xxxx")
banned = os.environ.get("BANNED", "").strip()
if banned:
    PATTERNS.append(("banned-term", "(?i)(" + banned + ")"))
DOTENV    = re.compile(r"(^|/)\.env(\.[^/]+)?$")
DOTENV_OK = re.compile(r"\.(example|sample|template)$")
ZEROS     = re.compile(r"^0+$")

hits, env_files = [], set()
for line in refs:
    parts = line.split()
    if len(parts) != 4:
        continue
    local_ref, local_sha, remote_ref, remote_sha = parts
    if ZEROS.match(local_sha):
        continue  # deleting a remote ref - nothing outgoing
    if ZEROS.match(remote_sha):
        args = [local_sha, "--not", "--remotes"]  # new branch: everything not already on a remote
    else:
        args = [remote_sha + ".." + local_sha]
    p = subprocess.run(["git", "log", "--no-color", "-p", "-U0"] + args,
                       capture_output=True, text=True)
    if p.returncode != 0:
        continue  # plumbing error (shallow clone etc.) - fail open, CI backstops
    fname, newln = None, 0
    for dl in p.stdout.splitlines():
        if dl.startswith("+++ b/"):
            fname = dl[6:]
            if DOTENV.search(fname) and not DOTENV_OK.search(fname):
                env_files.add(fname)
            continue
        if dl.startswith("@@"):
            m = re.search(r"\+([0-9]+)", dl)
            newln = int(m.group(1)) - 1 if m else 0
            continue
        if not dl.startswith("+") or dl.startswith("+++"):
            continue
        newln += 1
        added = dl[1:]
        for name, pat in PATTERNS:
            m = re.search(pat, added)
            if not m:
                continue
            if name == "generic-secret-assignment" and ALLOW.search(added):
                continue
            s = m.group(0)
            hits.append((fname or "?", newln, name, s[:4] + "..." + "(" + str(len(s)) + " chars)"))

if not hits and not env_files:
    sys.exit(0)
err = sys.stderr
err.write("pre-push BLOCKED: outgoing commits add secrets or sensitive content.\n")
for f in sorted(env_files):
    err.write("  " + f + ": dotenv file committed (only .env.example/.sample/.template may ship)\n")
for f, ln, name, masked in hits[:20]:
    err.write("  " + f + ":" + str(ln) + ": " + name + " " + masked + "\n")
if len(hits) > 20:
    err.write("  ... and " + str(len(hits) - 20) + " more\n")
err.write("Remove the secret, rewrite the unpushed commits, rotate anything already exposed.\n")
err.write("False positive? Bypass once with: SKIP_SECRET_HOOK=1 git push ...\n")
sys.exit(1)
' "$refs"
